  "meta": {
    "title": "列車時刻表查詢流程 (Timetable Query Flow)",
    "subtitle": "車站代碼轉換、官方時刻表動態爬取、HTML 表格結構解析與前端快取",
    "output": "timetable_flow.html",
    "quality_profile": "showcase",
    "views": [
      {
